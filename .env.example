# GO!CS runtime settings

# Retrieval provider:
# - local: local lightweight vector+keyword retrieval
# - data_engine: future external Data Engine retrieval (currently falls back locally)
# - hybrid: try Data Engine then fallback locally
GOCS_RETRIEVAL_PROVIDER=local

# Future Data Engine endpoint
GOCS_DATA_ENGINE_ENDPOINT=

# Existing project keys (example placeholders)
SUPABASE_PUBLIC_KEY=
SUPABASE_SERVICE_KEY=
